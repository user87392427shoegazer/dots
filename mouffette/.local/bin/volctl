#!/bin/sh
# volctl up|down|mute  -- changes volume, then tells waybar to refresh at once
s=@DEFAULT_AUDIO_SINK@
case "$1" in
  up)   wpctl set-volume -l 1.0 $s 5%+ ;;
  down) wpctl set-volume $s 5%- ;;
  mute) wpctl set-mute $s toggle ;;
esac
pkill -RTMIN+8 waybar 2>/dev/null || true
command -v eww >/dev/null 2>&1 && eww update vol="$(/home/soqu/.local/bin/rice-vol)" 2>/dev/null || true
